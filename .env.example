# Copy to .env (local only, never commit real secrets). No secrets needed yet.
# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Mobile (Expo) — the app reads this at build/start time.
# For a physical phone, replace localhost with your computer's LAN IP, e.g. http://192.168.1.23:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
